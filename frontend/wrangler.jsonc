// Cloudflare Workers deployment of the frontend (docs/deployment/deployment.md).
// Build: `npm run build` (creates dist/), deploy: `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitaphane",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths return index.html so React Router can handle them.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker code; every other request is served from the assets directly.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_URL": "https://kitaphane-api.onrender.com"
  },
  // Keep variables added in the dashboard when a new version is deployed from Git.
  "keep_vars": true
  // PROXY_SHARED_SECRET must be added as type "Secret": Cloudflare dashboard → Worker → Settings →
  // Variables and Secrets. Secrets are never removed by deploys.
}
